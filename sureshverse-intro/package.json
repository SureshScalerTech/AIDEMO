{
  "name": "sureshverse-intro",
  "version": "1.0.0",
  "private": true,
  "description": "SureshVerse cinematic YouTube channel intro — HTML/Canvas/Web Audio with deterministic 1920×1080 30 fps MP4 export",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs 8080",
    "export": "node scripts/export.mjs",
    "export:preview": "node scripts/export.mjs --preview",
    "export:frames": "node scripts/export.mjs --frames",
    "export:outro": "node scripts/export.mjs --comp outro",
    "export:outro:guide": "node scripts/export.mjs --comp outro --guide --mb 1",
    "export:all": "node scripts/export.mjs && node scripts/export.mjs --comp outro",
    "qc": "node scripts/qc.mjs",
    "qc:outro": "node scripts/qc.mjs output/sureshverse-outro.mp4 --duration 15"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED"
}
